# ── Ontos — docker compose settings ─────────────────────────────
# Copy to `.env` in this directory, fill in the four secrets, then:
#   docker compose up --build
#
# Generate each secret with:  openssl rand -hex 32
# Hex output is deliberate — MYSQL_PASSWORD is embedded in a connection URL,
# so characters like @ : / # would break it.

# Signs session tokens. 32+ random characters.
APP_SECRET=

# The `ontos` database user, and the MySQL root account.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Sign in with these. The account is created on first boot, and the password
# is re-applied on every start, so changing it here and restarting rotates it.
ADMIN_EMAIL=admin@acme-ontology.com
ADMIN_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────

# Host port for the web app.
# ONTOS_PORT=3000

# One-click persona login (Admin / Ontologist / Editor / Viewer). Anyone who
# can reach the server can then sign in as any role, admin included, without
# a password. Local demos only.
# ALLOW_DEMO_LOGIN=false

# Comma-separated origins allowed to call the API cross-origin. Same-origin
# use — the bundled web client — needs nothing here.
# ALLOWED_ORIGINS=
