# ── Ontos — docker compose settings ─────────────────────────────
# Copy to `.env` in this directory, fill in the four secrets, then:
#   docker compose up --build
#
# Generate each secret with:  openssl rand -hex 32
# Hex output is deliberate — MYSQL_PASSWORD is embedded in a connection URL,
# so characters like @ : / # would break it.

# Signs session tokens. 32+ random characters.
APP_SECRET=

# The `ontos` database user, and the MySQL root account.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Sign in with these. The account is created on first boot, and the password
# is re-applied on every start, so changing it here and restarting rotates it.
ADMIN_EMAIL=admin@acme-ontology.com
ADMIN_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────

# Host port for the web app.
# ONTOS_PORT=3000

# Seals connector credentials (SQL and broker passwords, client keys) in the
# database: 64 hex characters, from `openssl rand -hex 32`. Unset, a key
# derived from APP_SECRET is used, so changing APP_SECRET alone then makes
# stored credentials unreadable. Setting this later is safe: the next start
# re-seals everything under it. To rotate it, move the old value to
# SECRETS_KEY_PREVIOUS for one start, then remove that.
# SECRETS_KEY=
# SECRETS_KEY_PREVIOUS=

# One-click persona login (Admin / Ontologist / Editor / Viewer). Anyone who
# can reach the server can then sign in as any role, admin included, without
# a password. Local demos only.
# ALLOW_DEMO_LOGIN=false

# Comma-separated origins allowed to call the API cross-origin. Same-origin
# use — the bundled web client — needs nothing here.
# ALLOWED_ORIGINS=

# ── IoT Telemetry Brokers (Optional) ─────────────────────────────
# Automatically connect an external MQTT, AWS IoT Core, or Azure IoT broker on startup.
# The worker connects to it, and to the brokers added in the app: with several
# workers, one at a time, whichever holds the IoT lease in MySQL.
# Use a broker you control, over TLS, with authentication. Never a public test
# broker: anyone on the internet can publish to its topics, and whatever they
# send would be written into your twins.
# IOT_BROKER_URL=mqtts://your-broker.example.com:8883
# IOT_BROKER_TYPE=mqtt
# IOT_BROKER_TOPIC=ontos/twins/+/telemetry

# HTTP webhook at /api/iot/telemetry. The key grants write access to one
# workspace — IOT_WORKSPACE_ID, or the demo workspace when unset. The webhook
# is off until a key is set. Generate one with: openssl rand -hex 32
# IOT_WEBHOOK_API_KEY=
# IOT_WORKSPACE_ID=

# ── Engine host (Optional; not used by the app yet) ──────────────
# Only for the engine-host service, which runs one semantic engine per
# workspace:  docker compose --profile engine-host up -d engine-host
# Every request to it but /health needs this token, and it refuses to start
# without one (32+ characters). Generate it with: openssl rand -hex 32
# ENGINE_HOST_TOKEN=

