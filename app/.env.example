# ── Ontos — Enterprise Ontology & Digital Twin Platform ──────────
# Copy this file to `.env` and fill in the values.
# Only APP_SECRET and DATABASE_URL have no usable default.

# ── Application Identity ─────────────────────────────────────────
# Application identifier
APP_ID=ontos-local

# HS256 signing key for session JWTs. Use 32+ random characters.
APP_SECRET=change-me-to-a-real-secret

# ── Database ─────────────────────────────────────────────────────
# MySQL connection string
DATABASE_URL=mysql://root:@localhost:3306/ontos

# ── Admin ────────────────────────────────────────────────────────
# This address is auto-promoted to the admin role
ADMIN_EMAIL=admin@acme-ontology.com

# When set, `npm run db:bootstrap` creates or updates the admin account
# with this password (12+ characters). Production has no other way in.
# ADMIN_PASSWORD=

# Re-enables one-click persona login when NODE_ENV=production. Anyone who
# can reach the server can then sign in as any role, admin included.
# Development always allows persona login. Local demos only.
# ALLOW_DEMO_LOGIN=false

# ── Server ───────────────────────────────────────────────────────
# Production HTTP port
PORT=3000

# Comma-separated allowlist for CROSS-ORIGIN callers. In production, any
# cross-origin request not listed is rejected; same-origin use (the bundled
# web client) needs nothing here. Localhost is allowed outside production.
# ALLOWED_ORIGINS=https://ontos.example.com

# ── Semantic Engine (open-ontologies) ────────────────────────────
# Powers OWL-RL reasoning, W3C SHACL validation and SPARQL 1.1.
# Tested against v1.3.0: https://github.com/fabio-rovai/open-ontologies
# Binaries are gitignored — download the release for your platform (see
# the README). The server auto-starts the daemon if it finds the binary.

# Base URL of the engine daemon
OPEN_ONTOLOGIES_URL=http://127.0.0.1:8085

# Port used when auto-starting the daemon
OPEN_ONTOLOGIES_PORT=8085

# Explicit path to the binary. If unset, the server looks for
# `bin/open-ontologies[.exe]` at the repo root and under `app/`.
# OPEN_ONTOLOGIES_BIN=../bin/open-ontologies.exe

# Bearer token, if the engine is configured to require one
# OPEN_ONTOLOGIES_TOKEN=

# ── Frontend (exposed to browser via Vite) ───────────────────────
# Passed to the React frontend
VITE_APP_ID=ontos-local
