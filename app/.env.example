# ── Ontos — Enterprise Ontology & Digital Twin Platform ──────────
# Copy this file to `.env` and fill in the values.

# ── Application Identity ─────────────────────────────────────────
APP_ID=ontos-local             # Application identifier
APP_SECRET=change-me-to-a-real-secret  # Used for HS256 JWT signing

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=mysql://root:@localhost:3306/ontos  # MySQL connection string

# ── Admin ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@acme-ontology.com  # This email auto-promotes to admin role

# ── Frontend (exposed to browser via Vite) ───────────────────────
VITE_APP_ID=ontos-local        # Passed to the React frontend
